# OS Images
*.img
*.img.xz

# Media files
fighters_32/*
fighters_64/*
# gifs/*
# Allow the default font to be committed but ignore others
fonts/*
!fonts/*.bdf
!fonts/PressStart2P.ttf
!fonts/VT323.ttf
!fonts/DotGothic16.ttf

# Python
__pycache__/
*.pyc
venv/

# Runtime-generated config (created at first boot, contains a random API token - never commit)
data/

# IDEs
.idea/
.vscode/
.DS_Store

# Temporary files
.fuse_hidden*
*.zip

# Rust
target/
Cargo.lock.tmp
*.profraw

# C++ Dependency Clones
rust-rpi-rgb-led-matrix/
rust-rpi-rgb-led-matrix-local/

# Antigravity Temp Files
scratch/
.tempmediaStorage/
# Root-level scratch test binaries/artifacts (anchored so tests/*.rs stay tracked)
/test_*
assets.tar.gz

# One-off dev scratch scripts (source mutators, applied manually - never commit)
fix_*.py
patch_*.py
patch_*.sh
clean_app.py

# Obsolete/generated artifacts (engines.json is a dump of GET /api/engines)
engines.json
conf.ini
conf.ini.backup


# Node (doc tooling, not part of the project)
node_modules/
package-lock.json
